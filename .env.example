# Free key, no credit card needed: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Yaa Groq use karo (free, fast): https://console.groq.com  pe free key lo
# MODEL_PROVIDER=groq
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: change which directory the agent's file/shell tools operate on.
# Defaults to ./workspace
AGENT_WORKSPACE=./workspace

# Optional: context window management
# Summarize conversation when estimated tokens exceed this budget.
# Lower = summarize sooner (saves tokens, keeps context fresh).
# CONTEXT_BUDGET_TOKENS=50000
# Number of recent turns to always keep (never summarize these).
# SUMMARIZE_TAIL_TURNS=6

# Optional: sandbox tuning
# SANDBOX_ENABLED=true
# SANDBOX_IMAGE=python:3.12-slim
